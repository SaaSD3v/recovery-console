# Copy this file to builder/REQUEST.env to trigger a Channel recovery-as-boot build.
# Every push that changes REQUEST.env starts four rotation jobs.

# Device profile branch.
SOURCE_REF=Channel-Configs

# Choose EXACTLY ONE TWRP installer ZIP source:
# 1) Direct HTTPS URL
TWRP_ZIP_URL=''
# 2) File committed/uploaded in this builder branch
TWRP_ZIP_PATH='builder/input/twrp-channel-installer.zip'

# Optional SHA-256 guard for the base installer ZIP.
TWRP_ZIP_SHA256=''

# Channel is arm64.
ARCHITECTURE=aarch64

# Prefix used for generated artifacts.
OUTPUT_PREFIX=channel-recovery-console

# Use "none" to omit seclabel from the injected init service.
SECLABEL='u:r:recovery:s0'

# Optional direct Magisk APK URL. Leave empty to use latest official release
# only for the host x86_64 magiskboot used to edit the ramdisk in CI.
MAGISK_APK_URL=''

# Change this value to rebuild the exact same configuration.
REQUEST_ID=1
