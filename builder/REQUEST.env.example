# Copy this file to builder/REQUEST.env to trigger a build.
# Every push that changes REQUEST.env starts four recovery-image jobs.

# Branch/tag/commit containing the device-specific recovery-console config.
SOURCE_REF=Albus-Configs

# Choose EXACTLY ONE recovery source:
# 1) Direct HTTPS URL (GitHub Release asset recommended)
RECOVERY_URL=''
# 2) File already committed/uploaded in this builder branch
RECOVERY_PATH='builder/input/recovery.img'

# Optional SHA-256 guard for the base recovery image. Leave empty to skip.
RECOVERY_SHA256=''

# Supported: aarch64, armhf, x86_64, x86
ARCHITECTURE=aarch64

# Prefix used for generated artifacts/images.
OUTPUT_PREFIX=albus-recovery-console

# Use "none" to omit seclabel from the injected init service.
SECLABEL='u:r:recovery:s0'

# Optional direct Magisk APK URL. Leave empty to use the latest official release.
MAGISK_APK_URL=''

# Change this value when you want to rebuild the exact same configuration.
REQUEST_ID=1
